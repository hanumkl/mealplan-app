# Copy to .env for local development.
# On Databricks Apps, LAKEBASE_URL is resolved from the "database/lakebase-url"
# secret via web/app.yaml - do NOT commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

# Stage 2 (YouTube recipe harvest) - not needed for Stage 1
YOUTUBE_SECRET_SCOPE=mealplan
YOUTUBE_SECRET_KEY=youtube-api-key

# Local dev only
PORT=8000
DEFAULT_HOUSEHOLD_ID=1
